# ============================================================
# ThingsVis Server Environment Variables
# ============================================================
# Copy this file to .env and fill in the values:
#   cp apps/server/.env.example apps/server/.env
# ============================================================

# ─── Database ────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:your_password_here@127.0.0.1:5432/thingsvis?schema=public"

# ─── Authentication ─────────────────────────────────────────
# Required in production. Generate a secure secret with: openssl rand -base64 32
# Do not deploy with the placeholder value below.
AUTH_SECRET="change-me-to-a-secure-random-string"

# Public-facing URL of the application (used for OAuth callbacks)
AUTH_URL="http://localhost:3000"

# Trust the host header (required when behind a proxy)
AUTH_TRUST_HOST=true

# ─── Server ─────────────────────────────────────────────────
# Port the API server listens on
PORT=8000

# ─── CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS
# Example: http://your-domain.com,http://another-domain.com
ALLOWED_ORIGINS=

# ─── Seed (optional) ────────────────────────────────────────
# Override default admin credentials for the seed script
# SEED_ADMIN_EMAIL=admin@thingsvis.io
# SEED_ADMIN_PASSWORD=admin123
# SEED_ADMIN_NAME=Admin

# Upload security limits (positive integers, bytes / requests per user per minute)
UPLOAD_IMAGE_MAX_BYTES=10485760
UPLOAD_MODEL_MAX_BYTES=52428800
UPLOAD_TOTAL_MAX_BYTES=1073741824
UPLOAD_REQUESTS_PER_MINUTE=10

# Optional additional self public IPs/hostnames (e.g. public NAT IP), comma-separated.
# ASSET_SELF_HOSTS=203.0.113.10,thingsvis.example.com
